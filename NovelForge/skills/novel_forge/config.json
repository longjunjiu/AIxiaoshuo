{
  "name": "novel-forge",
  "version": "1.0.0",
  "description": "AI小说辅助创作技能 - 百万字级长篇作品创作系统",
  "author": "NovelForge Team",
  "license": "MIT",
  "requires": "python >= 3.9",
  "dependencies": {
    "pyyaml": ">= 6.0",
    "requests": ">= 2.28.0",
    "numpy": ">= 1.24.0",
    "tiktoken": ">= 0.3.0"
  },
  "optional_dependencies": {
    "chromadb": ">= 0.4.0",
    "anthropic": ">= 0.18.0",
    "openai": ">= 1.0.0"
  },
  "config_schema": {
    "llm_provider": "openai | anthropic | custom",
    "api_key": "string (required)",
    "base_url": "string (optional)",
    "model": "string (default: gpt-4)",
    "temperature": "float (default: 0.7)",
    "max_tokens": "integer (default: 4096)",
    "embedding_model": "string (optional)"
  }
}
